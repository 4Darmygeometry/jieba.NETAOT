<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>JiebaNet.AotTest</AssemblyName>
    <RootNamespace>JiebaNet.AotTest</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);AOTBA</DefineConstants>
  </PropertyGroup>

  <!-- .NET 11+强制runtime-async以提升性能 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Analyser\Analyser.csproj" />
    <ProjectReference Include="..\..\src\Segmenter\Segmenter.csproj" />
  </ItemGroup>

</Project>
